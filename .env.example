HANA_HOST=your-hana-host
HANA_PORT=30015
HANA_USER=
HANA_PASSWORD=
HANA_SCHEMA=your_hana_schema
HANA_ENCRYPT=false
HANA_SSL_VALIDATE_CERTIFICATE=false
API_PORT=3001
# Hostinger proporciona PORT automaticamente; no es necesario configurarlo alli.
HOMENAJES_CACHE_TTL_MS=300000
PREVISION_LIMIT=0
PREVISION_CACHE_TTL_MS=21600000
RETIROS_CACHE_TTL_MS=21600000
# Opcional. Por defecto se usa %LOCALAPPDATA%/CesincorDashboard/cache.
DASHBOARD_CACHE_DIR=

# Solo en Hostinger: URL HTTPS del túnel hacia la oficina y su clave.
UPSTREAM_API_URLS=
UPSTREAM_API_TOKEN=
UPSTREAM_API_TIMEOUT_MS=150000

# Solo en el PC/servidor de la oficina: protege los endpoints de datos.
GATEWAY_SHARED_SECRET=
