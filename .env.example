HANA_HOST=your-hana-host
HANA_PORT=30015
HANA_USER=
HANA_PASSWORD=
HANA_SCHEMA=your_hana_schema
HANA_ENCRYPT=false
HANA_SSL_VALIDATE_CERTIFICATE=false
API_PORT=3001
# Hostinger proporciona PORT automaticamente; no es necesario configurarlo alli.
HOMENAJES_CACHE_TTL_MS=300000
PREVISION_LIMIT=0
PREVISION_CACHE_TTL_MS=21600000
RETIROS_CACHE_TTL_MS=21600000
# Opcional. Por defecto se usa %LOCALAPPDATA%/CesincorDashboard/cache.
DASHBOARD_CACHE_DIR=

# Supabase Auth. La clave secreta se usa exclusivamente en Express.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
SUPABASE_SECRET_KEY=sb_secret_your_server_key
APP_URL=https://dashboard.example.com
